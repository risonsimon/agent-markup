{
  "name": "agent-markup",
  "version": "0.1.0",
  "private": true,
  "description": "Visually edit any live website and copy a precise prompt for your coding agent.",
  "type": "module",
  "scripts": {
    "build": "bun build.mjs",
    "watch": "bun build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun build.mjs --test && bun tests/e2e.mjs",
    "test:sites": "bun build.mjs --test && bun tests/real-sites.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
